{
  "expo": {
    "name": "allWhist",
    "slug": "allwhist",
    "version": "1.1.0",
    "orientation": "default",
    "scheme": "allwhist",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#ffffff",
    "icon": "./assets/allwhist_icon_512x512.png",
    "splash": {
      "image": "./assets/allwhist_splash_1280x720.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.allwhist.app"
    },
    "android": {
      "package": "com.allwhist.app",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/allwhist_adaptive_108x108.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "27.1.12297006"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4266277576724378~1345148479",
          "iosAppId": "REPLACE_WITH_YOUR_REAL_IOS_ADMOB_APP_ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}