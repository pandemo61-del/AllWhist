{
  "expo": {
    "name": "allWhist",
    "slug": "allwhist",
    "version": "1.1.1",

    "orientation": "default",
    "scheme": "allwhist",

    "userInterfaceStyle": "dark",
    "backgroundColor": "#ffffff",

    "icon": "./assets/allwhist_icon_512x512.png",

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.allwhist.app"
    },

    "android": {
      "package": "com.allwhist.app",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/allwhist_adaptive_108x108.png",
        "backgroundColor": "#ffffff"
      }
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/allwhist_splash_1280x720.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain"
        }
      ],

      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "27.1.12297006"
          }
        }
      ],

      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4266277576724378~1345148479",
          "iosAppId": "ca-app-pub-4266277576724378~1345148479"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    }
  }
}