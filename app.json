{
  "expo": {
    "name": "allWhist",
    "slug": "allwhist",
    "version": "1.1.0",
    "orientation": "default",
    "scheme": "allwhist",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#ffffff",
    "icon": "./assets/allwhist_icon_512x512.png",
    "splash": {
      "image": "./assets/allwhist_splash_1280x720.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.allwhist.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/allwhist_adaptive_108x108.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.allwhist.app",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "resize"
    },
    "androidStatusBar": {
      "hidden": false,
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4266277576724378~1345148479",
          "iosAppId": "ca-app-pub-3940256099942544~4411468910"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
